<Window x:Class="ProjectionManager.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 · Glory 榮耀"
        Width="820" Height="820" MinWidth="700" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="pack://application:,,,/Assets/glory_logo.png"
        FontFamily="Microsoft JhengHei UI">

    <Window.Resources>
        <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SettingsHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="PrimarySettingsButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0,2,0,2" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="pack://application:,,,/Assets/glory_logo.png"
                       Width="40" Height="40" Margin="0,0,14,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="設定" FontSize="21" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Glory 榮耀 · 投影控制台" FontSize="12"
                               Foreground="{DynamicResource TextFaintBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="主題與目錄" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="12" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,20">

                <TextBlock Text="外觀主題" Style="{StaticResource SettingsSectionTitle}" />
                <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <StackPanel>
                        <RadioButton x:Name="BlackGoldRadio" GroupName="UiTheme" Tag="0"
                                     Checked="Theme_Checked">
                            <StackPanel Margin="6,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="44" Height="26" CornerRadius="4" Background="#000000"
                                            BorderBrush="#E8B84A" BorderThickness="1" Margin="0,0,10,0" />
                                    <TextBlock Text="黑金（預設）" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="純黑背景、金色強調、奶油金文字；高對比，適合昏暗的聚會現場。"
                                           Style="{StaticResource SettingsHint}" Margin="0,4,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="ClassicRadio" GroupName="UiTheme" Tag="1"
                                     Checked="Theme_Checked">
                            <StackPanel Margin="6,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="44" Height="26" CornerRadius="4" Background="#171B21"
                                            BorderBrush="#47D1C4" BorderThickness="1" Margin="0,0,10,0" />
                                    <TextBlock Text="現有配色" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="保留目前 V2.2 的深灰底與青綠重點色，適合已熟悉舊版的操作員。"
                                           Style="{StaticResource SettingsHint}" Margin="0,4,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="LightRadio" GroupName="UiTheme" Tag="2"
                                     Checked="Theme_Checked">
                            <StackPanel Margin="6,0,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="44" Height="26" CornerRadius="4" Background="#F7F5EF"
                                            BorderBrush="#9A6A12" BorderThickness="1" Margin="0,0,10,0" />
                                    <TextBlock Text="白色背景" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="暖白底、深墨文字、深金重點色；適合室內明亮或需要列印截圖的場合。"
                                           Style="{StaticResource SettingsHint}" Margin="0,4,0,0" />
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="切換後立即套用到整個控制台，不需要重新啟動。"
                                   Style="{StaticResource SettingsHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="調試與模擬螢幕" Style="{StaticResource SettingsSectionTitle}" Margin="0,22,0,10" />
                <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="18,14">
                    <StackPanel>
                        <CheckBox x:Name="DebugModeCheck" Content="開啟調試模式（模擬屏幕 2）"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                                  Checked="DebugMode_Changed" Unchecked="DebugMode_Changed" />
                        <TextBlock Text="只有一台實體螢幕時，把主螢幕右半模擬成第二螢幕，投影視窗會落在右半，方便測試推送、黑屏與翻頁。關閉開關或重新整理螢幕即可恢復。"
                                   Style="{StaticResource SettingsHint}" Margin="24,7,0,0" />
                        <TextBlock Text="此模式只影響投影目標的模擬，不會修改 PowerPoint 或素材檔。實機驗收前請關閉。"
                                   Style="{StaticResource SettingsHint}" Margin="24,6,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="選檔起始資料夾" Style="{StaticResource SettingsSectionTitle}" Margin="0,22,0,10" />
                <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="主 PPT 選檔"
                                   Foreground="{DynamicResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="PresentationFolderText"
                                 Style="{StaticResource PathBox}" Margin="10,0,10,0" />
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button Content="選擇" Click="BrowsePresentationFolder_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                            <Button Content="清除" Click="ClearPresentationFolder_Click"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="素材選檔／資料夾"
                                   Foreground="{DynamicResource TextDimBrush}" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,12,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MaterialFolderText"
                                 Style="{StaticResource PathBox}" Margin="10,12,10,0" />
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="選擇" Click="BrowseMaterialFolder_Click"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                            <Button Content="清除" Click="ClearMaterialFolder_Click"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="只影響下次開啟選檔／資料夾對話框的起始位置；素材仍存在原本的快取目錄，不會搬移或失效。"
                                   Style="{StaticResource SettingsHint}" Margin="0,10,0,0" />
                    </Grid>
                </Border>

                <TextBlock Text="儲存、快取與日誌" Style="{StaticResource SettingsSectionTitle}" Margin="0,22,0,10" />
                <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="設定檔"
                                   Foreground="{DynamicResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="SettingsPathText"
                                 Style="{StaticResource PathBox}" Margin="10,0,10,0" />
                        <Button Grid.Row="0" Grid.Column="2" Content="開啟資料夾" Tag="settings"
                                Click="OpenFolder_Click" Style="{StaticResource SecondaryButton}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="素材索引"
                                   Foreground="{DynamicResource TextDimBrush}" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,10,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MaterialIndexText"
                                 Style="{StaticResource PathBox}" Margin="10,10,10,0" />
                        <Button Grid.Row="1" Grid.Column="2" Content="開啟資料夾" Tag="materialIndex"
                                Click="OpenFolder_Click" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="素材快取"
                                   Foreground="{DynamicResource TextDimBrush}" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,10,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="MaterialCacheText"
                                 Style="{StaticResource PathBox}" Margin="10,10,10,0" />
                        <Button Grid.Row="2" Grid.Column="2" Content="開啟資料夾" Tag="materialCache"
                                Click="OpenFolder_Click" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="預覽暫存"
                                   Foreground="{DynamicResource TextDimBrush}" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,10,0,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="PreviewCacheText"
                                 Style="{StaticResource PathBox}" Margin="10,10,10,0" />
                        <Button Grid.Row="3" Grid.Column="2" Content="開啟資料夾" Tag="previewCache"
                                Click="OpenFolder_Click" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="操作日誌"
                                   Foreground="{DynamicResource TextDimBrush}" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,10,0,0" />
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="LogPathText"
                                 Style="{StaticResource PathBox}" Margin="10,10,10,0" />
                        <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="開啟" Tag="logs"
                                    Click="OpenFolder_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                            <Button Content="匯出診斷包"
                                    Click="ExportDiagnostics_Click" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="操作與錯誤日誌保存在本機 AppData；發生錯誤時，可在上方開啟日誌資料夾，或按「匯出診斷包」把日誌與設定打包給技術支援。"
                           Style="{StaticResource SettingsHint}" Margin="0,10,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <TextBlock Text="Glory 榮耀 · V2.3　｜　設定會立即儲存"
                           Foreground="{DynamicResource TextFaintBrush}" FontSize="12" VerticalAlignment="Center" />
                <Button Content="關閉" Click="Close_Click"
                        Style="{StaticResource PrimarySettingsButton}"
                        HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
