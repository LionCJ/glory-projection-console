<Window x:Class="ProjectionManager.WebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="網頁投影"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual"
        Background="#0B0D10">

    <Grid Background="#0B0D10">
        <ContentControl x:Name="BrowserHost" />
        <TextBlock x:Name="Hint" Text="正在載入網頁…" Foreground="#7B838C" FontSize="22"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
</Window>
