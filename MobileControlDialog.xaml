<Window x:Class="ProjectionManager.MobileControlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手機控制" Width="780" Height="720" MinWidth="700" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DimText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="FaintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="UrlBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TealBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoleCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="手機控制（遙控器）" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="StatusText" Text="—" Foreground="{DynamicResource TextFaintBrush}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,16,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" x:Name="ServiceDot" Width="10" Height="10" Fill="{DynamicResource TextFaintBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ServiceStateText" Text="服務狀態：—" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="ServiceDetailText" Text="—" Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="StartServiceButton" Content="啟動服務" Click="StartService_Click"
                            Style="{StaticResource SmallButton}" Margin="10,0,0,0" Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentTextBrush}" />
                    <Button Grid.Column="3" x:Name="StopServiceButton" Content="停止服務" Click="StopService_Click"
                            Style="{StaticResource SmallButton}" Margin="8,0,0,0" />
                    <Button Grid.Column="4" x:Name="SelfTestButton" Content="本機自測" Click="SelfTest_Click"
                            Style="{StaticResource SmallButton}" Margin="8,0,0,0" />
                </Grid>

                <TextBlock x:Name="NetworkText" Text="—" Style="{StaticResource FaintText}" TextWrapping="Wrap" Margin="20,8,0,0" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="手機打開" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox Grid.Column="1" x:Name="UrlText" Style="{StaticResource UrlBox}" />
                    <Button Grid.Column="2" Content="複製" Click="CopyUrl_Click" Style="{StaticResource SmallButton}" Margin="10,0,0,0" />
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="配對碼" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" x:Name="PinText" Text="------" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AmberBrush}" VerticalAlignment="Center" Margin="0,0,18,0" />
                    <TextBlock Grid.Column="2" Text="手機輸入這組號碼即可綁定，之後不必再輸。" Style="{StaticResource FaintText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="3" Content="更新配對碼" Click="RegeneratePin_Click" Style="{StaticResource SmallButton}" Margin="10,0,0,0" />
                </Grid>

                <CheckBox x:Name="EnableCheck" Content="啟動手機控制" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"
                          Margin="0,14,0,0" Checked="EnableCheck_Changed" Unchecked="EnableCheck_Changed" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="已綁定的手機" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="角色可即時切換：講員只能上下頁" Style="{StaticResource FaintText}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="2" x:Name="RefreshDevicesButton" Content="刷新列表" Click="RefreshDevices_Click"
                    Style="{StaticResource SmallButton}" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DevicePanel" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" TextWrapping="Wrap" Style="{StaticResource FaintText}"
                       Text="同一個 Wi-Fi、同一區網。手機不需要裝 App，也不需要連外網；關掉這個視窗不會中斷控制。" />
            <Button Grid.Column="1" Content="關閉" Click="Close_Click" Style="{StaticResource SmallButton}" Margin="16,0,0,0" />
        </Grid>
    </Grid>
</Window>
