<Window x:Class="ProjectionManager.MaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="投影素材"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual"
        Background="Black">

    <Grid Background="Black">
        <Image x:Name="SlideImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock x:Name="EmptyText" Text="素材未載入" Foreground="#555555" FontSize="24"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</Window>
