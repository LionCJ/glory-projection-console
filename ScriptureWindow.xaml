<Window x:Class="ProjectionManager.ScriptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="經文投影"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual"
        Background="#0B1220">

    <Grid x:Name="RootGrid" Background="#0B1220">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="RefText" Grid.Row="0" Text="" Margin="90,54,90,0"
                   FontSize="30" Foreground="#8FB3D9" FontWeight="SemiBold" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False">
            <StackPanel x:Name="LinesHost" Margin="90,26,90,26" VerticalAlignment="Center" />
        </ScrollViewer>

        <TextBlock x:Name="PageText" Grid.Row="2" Text="" Margin="90,0,90,40"
                   FontSize="20" Foreground="#5C6B7E" HorizontalAlignment="Right" />
    </Grid>
</Window>
