<Window x:Class="ProjectionManager.WebDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增網頁投影" Width="440" Height="270"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Microsoft JhengHei" FontSize="13">

    <Grid Margin="20">
        <Grid.Resources>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource InputBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                <Setter Property="Padding" Value="9,0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="名稱（顯示在左欄，例：詩歌歌詞）" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Grid.Row="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,12" />

        <TextBlock Text="網址（https://…）" Grid.Row="2" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,4" />
        <TextBox x:Name="UrlBox" Grid.Row="3" Height="30" VerticalContentAlignment="Center" Text="https://" />

        <TextBlock Grid.Row="4" Text="網頁會在投影螢幕全螢幕顯示；控制台可重新載入與上下滾動。"
                   Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" Margin="0,14,0,0" VerticalAlignment="Top" />

        <Grid Grid.Row="5" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="取消" Height="32" Margin="0" VerticalAlignment="Center" Click="Cancel_Click" />
            <Button Grid.Column="2" Content="加入並投影" Height="32" Margin="0" VerticalAlignment="Center" IsDefault="True" Click="Ok_Click"
                    Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" />
        </Grid>
    </Grid>
</Window>
