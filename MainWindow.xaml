<Window x:Class="ProjectionManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glory 榮耀 · 投影控制台"
        Height="900" Width="1400" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="pack://application:,,,/Assets/glory_logo.png"
        FontFamily="Microsoft JhengHei UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <!-- 主題畫刷由 ThemeManager 建立；這裡不再寫死色值，切換主題時即時更新。 -->

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SectionHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- 深色下拉：收合時深底亮字，展開清單也是深底亮字 -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" />
                            <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                                  Data="M 0 0 L 9 0 L 4.5 5 Z" Fill="{DynamicResource TextDimBrush}" />
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 投影源卡片：用 Button 而不是 Border，鍵盤與自動化都能操作 -->
        <Style x:Key="SourceCardStyle" TargetType="Button">            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel2Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 頂部工具列 ============ -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/glory_logo.png"
                           Width="30" Height="30" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Glory" Foreground="{DynamicResource TealBrush}" FontSize="17" FontWeight="Bold" />
                        <TextBlock Text="榮耀 · 投影控制台" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
                    <Button x:Name="OpenButton" Content="加入主 PPT" Click="OpenButton_Click" Style="{StaticResource FlatButton}" Height="34" Margin="0,0,8,0" />
                    <Button x:Name="StartShowButton" Content="開始放映" Click="StartShowButton_Click" Style="{StaticResource PrimaryButton}" Height="34" Margin="0,0,16,0" />
                    <Border Width="1" Height="26" Background="{DynamicResource LineBrush}" Margin="0,0,14,0" />
                    <Button x:Name="BlackButton" Content="黑屏" Click="BlackButton_Click" Style="{StaticResource FlatButton}" Height="34" Margin="0,0,8,0" />
                    <Button x:Name="ResumeButton" Content="恢復畫面" Click="ResumeButton_Click" Style="{StaticResource FlatButton}" Height="34" Margin="0,0,8,0" />
                    <Button x:Name="RepositionButton" Content="重新定位" Click="RepositionButton_Click" Style="{StaticResource FlatButton}" Height="34" Margin="0,0,8,0" />
                    <Button x:Name="EndShowButton" Content="結束放映" Click="EndShowButton_Click" Style="{StaticResource FlatButton}" Height="34" Margin="0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Content="設定" Click="SettingsButton_Click" Style="{StaticResource FlatButton}"
                            Height="34" Margin="0,0,10,0" ToolTip="主題、目錄與進階設定" />
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,0" Height="34">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ShowDot" Width="8" Height="8" Fill="{DynamicResource TextFaintBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="ShowStateText" Text="未開始放映" Foreground="{DynamicResource TextDimBrush}" FontSize="13" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 三欄主體 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- 左：投影源 -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="14,0">
                            <TextBlock Text="投影源" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="SourceCountText" Text="—" Foreground="{DynamicResource TextFaintBrush}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Button x:Name="SourceSearchToggle" Content="查找" Click="SourceSearchToggle_Click"
                                        Style="{StaticResource FlatButton}" Height="26" Padding="8,0" FontSize="12" Margin="0,0,6,0" />
                                <Button x:Name="AddGroupButton" Content="＋ 分組" Click="AddGroup_Click"
                                        Style="{StaticResource FlatButton}" Height="26" Padding="8,0" FontSize="12" Margin="0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="SourceSearchPanel" Grid.Row="1" Visibility="Collapsed"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="52" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourceSearchBox" Grid.Row="0" Grid.Column="0" Height="30" FontSize="13"
                                     VerticalContentAlignment="Center" ToolTip="輸入素材或分組名稱關鍵字"
                                     KeyDown="SourceSearchBox_KeyDown" />
                            <Button x:Name="SourceSearchButton" Grid.Row="0" Grid.Column="2" Content="查找" Height="30"
                                    Click="SourceSearchButton_Click" Style="{StaticResource PrimaryButton}" Padding="8,0" Margin="0" FontSize="12" />
                            <Button x:Name="SourceSearchClearButton" Grid.Row="0" Grid.Column="4" Content="清除" Height="30"
                                    Click="SourceSearchClearButton_Click" Style="{StaticResource FlatButton}" Padding="8,0" Margin="0" FontSize="12" />
                            <TextBlock x:Name="SourceSearchStatus" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                                       Text="輸入關鍵字後按「查找」" Foreground="{DynamicResource TextFaintBrush}"
                                       FontSize="11" Margin="2,6,0,0" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="SourceScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  AllowDrop="True" Background="Transparent"
                                  ToolTip="可將 PowerPoint 簡報、圖片或資料夾拖到這裡加入素材；會放入目前選取的分組"
                                  DragOver="SourcePanel_DragOver" DragLeave="SourcePanel_DragLeave"
                                  Drop="SourcePanel_Drop">
                        <StackPanel x:Name="SourcePanel" Margin="8,10,8,8" />
                    </ScrollViewer>

                    <!-- 加入投影源：兩個一排，不再擠成一長串 -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ImportMaterialButton" Grid.Row="0" Grid.Column="0" Content="＋ 素材"
                                    Click="ImportMaterial_Click" Style="{StaticResource FlatButton}" Height="34" Margin="0" />
                            <Button x:Name="ImportFolderButton" Grid.Row="0" Grid.Column="2" Content="＋ 資料夾"
                                    Click="ImportFolder_Click" Style="{StaticResource FlatButton}" Height="34" Margin="0" />
                            <Button x:Name="ScriptureButton" Grid.Row="1" Grid.Column="0" Content="＋ 經文"
                                    Click="ScriptureButton_Click" Style="{StaticResource FlatButton}" Height="34" Margin="0,8,0,0" />
                            <Button x:Name="WebButton" Grid.Row="1" Grid.Column="2" Content="＋ 網頁"
                                    Click="WebButton_Click" Style="{StaticResource FlatButton}" Height="34" Margin="0,8,0,0" />
                            <Button x:Name="ZoomButton" Content="Zoom 投影" Grid.Row="2" Grid.ColumnSpan="3"
                                    Click="ZoomButton_Click" Style="{StaticResource FlatButton}" Height="32" Margin="0,8,0,0"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 中：預覽 -->
            <Grid x:Name="CenterColumn" Grid.Column="1" Margin="18,16,18,0" SizeChanged="CenterColumn_SizeChanged">
                <Grid.RowDefinitions>
                    <!-- 預覽高度依卡片寬度維持約 4:3；4:3 素材幾乎填滿，16:9 素材上下留黑仍完整顯示 -->
                    <RowDefinition x:Name="PreviewRow" Height="230" MinHeight="168" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="170" />
                </Grid.RowDefinitions>

                <Grid x:Name="PreviewArea" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：目前播出／目前選擇頁 -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="2,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource TealBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="PreviewLiveStateLabel" Text="尚未播出" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="PreviewLiveName" Text="—" Foreground="{DynamicResource TextDimBrush}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource PreviewBrush}" BorderBrush="{DynamicResource TealBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Image x:Name="PreviewLiveImage" Stretch="Uniform" />
                                <TextBlock x:Name="PreviewLiveHint" Foreground="{DynamicResource TextDimBrush}" FontSize="15"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Text="尚未選擇投影源" />
                                <TextBlock x:Name="PreviewLiveText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" LineHeight="28"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                                           Margin="22,18" VerticalAlignment="Center" Visibility="Collapsed" />
                                <Border x:Name="PreviewLivePageBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,12,10" Padding="9,4" CornerRadius="6"
                                        Background="{DynamicResource BadgeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Visibility="Collapsed" IsHitTestVisible="False">
                                    <TextBlock x:Name="PreviewLivePage" Text="" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 右：下一頁 -->
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="2,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="下一頁" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="PreviewNextName" Text="—" Foreground="{DynamicResource TextDimBrush}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource PreviewBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Image x:Name="PreviewNextImage" Stretch="Uniform" />
                                <TextBlock x:Name="PreviewNextText" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" LineHeight="26"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                                           Margin="20,16" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="PreviewNextHint" Foreground="{DynamicResource TextFaintBrush}" FontSize="14"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Text="—" />
                                <Border x:Name="PreviewNextPageBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,12,10" Padding="9,4" CornerRadius="6"
                                        Background="{DynamicResource BadgeBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Visibility="Collapsed" IsHitTestVisible="False">
                                    <TextBlock x:Name="PreviewNextPage" Text="" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 翻頁控制：固定兩排，避免窄視窗時 WrapPanel 把「頁碼／跳至／末頁」擠到第二排造成參差 -->
                <Grid x:Name="NavBar" Grid.Row="1" Margin="0,14,0,12" SizeChanged="NavBar_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PrevButton" Grid.Column="0" Content="◀ 上一頁" Click="PrevButton_Click" Style="{StaticResource FlatButton}" Height="40" MinWidth="100" Padding="10,0" Margin="0,0,8,0" FontSize="14" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        <Button x:Name="NextButton" Grid.Column="1" Content="下一頁 ▶" Click="NextButton_Click" Style="{StaticResource PrimaryButton}" Height="40" MinWidth="100" Padding="10,0" Margin="0,0,8,0" FontSize="14" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        <Button x:Name="PushMaterialButton" Grid.Column="2" Content="推送投影" Click="PushMaterialButton_Click" Style="{StaticResource PrimaryButton}" Height="40" MinWidth="100" Padding="10,0" Margin="0" FontSize="14" HorizontalAlignment="Stretch" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                        <TextBlock Text="跳到" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="PageJumpBox" Width="64" Height="40" FontSize="15" TextAlignment="Center"
                                 VerticalContentAlignment="Center" MaxLength="4" ToolTip="輸入頁碼後按 Enter"
                                 Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}" KeyDown="PageJumpBox_KeyDown" VerticalAlignment="Center" />
                        <TextBlock Text="頁" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center" Margin="6,0,10,0" />
                        <Button x:Name="JumpButton" Content="跳至" Click="JumpButton_Click" Style="{StaticResource FlatButton}" Height="40" Padding="14,0" Margin="0,0,8,0" FontSize="14" VerticalAlignment="Center" />
                        <Button x:Name="JumpLastButton" Content="末頁" Click="JumpLastButton_Click" Style="{StaticResource FlatButton}" Height="40" Padding="14,0" Margin="0,0,8,0" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="NavHintText" Grid.RowSpan="2" Text="翻頁筆未綁定" Foreground="{DynamicResource TextFaintBrush}" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,14" MaxWidth="340"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                </Grid>

                <!-- 縮圖條 -->
                <Border x:Name="ThumbArea" Grid.Row="2" Background="{DynamicResource PreviewPanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6,8,0" SizeChanged="ThumbArea_SizeChanged">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="ThumbPanel" Orientation="Horizontal" VerticalAlignment="Top" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 右：屬性 -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,10">
                        <!-- 放映 -->
                        <StackPanel Margin="16,14,16,0">
                            <Button x:Name="ShowSectionHeader" Content="放映設定　▾" Click="SectionHeader_Click"
                                    Tag="放映設定" Style="{StaticResource SectionHeaderButton}" />
                            <StackPanel x:Name="ShowSectionBody" Margin="0,8,0,12">
                                <ComboBox x:Name="MonitorCombo" Height="34" Margin="0,0,0,10"
                                          Style="{StaticResource DarkCombo}"
                                          ItemContainerStyle="{StaticResource DarkComboItem}"
                                          SelectionChanged="MonitorCombo_SelectionChanged" />
                                <Button x:Name="RefreshMonitorsButton" Content="重新整理螢幕" Click="RefreshMonitors_Click" Style="{StaticResource FlatButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
                                <TextBlock x:Name="TargetInfoText" Text="投影目標：—" Foreground="{DynamicResource TextFaintBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <CheckBox x:Name="WindowedShowCheck" Content="視窗化放映（失焦仍播動畫）" Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,0,0,8" Checked="ShowOption_Changed" Unchecked="ShowOption_Changed" />
                                <CheckBox x:Name="NoActivateCheck" Content="放映時控制台不主動搶焦點" Foreground="{DynamicResource TextPrimaryBrush}"
                                          ToolTip="開啟後，程式不會主動把焦點從放映視窗搶走；你仍可用滑鼠點擊控制台操作。"
                                          Margin="0,0,0,8" Checked="ShowOption_Changed" Unchecked="ShowOption_Changed" />
                                <CheckBox x:Name="LockCursorCheck" Content="鎖定鼠標在作業螢幕" Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,0,0,2" Checked="LockCursorCheck_Changed" Unchecked="LockCursorCheck_Changed" />
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource LineBrush}" />

                        <!-- 翻頁筆 -->
                        <StackPanel Margin="16,14,16,0">
                            <Button x:Name="PenSectionHeader" Content="翻頁筆　▸" Click="SectionHeader_Click"
                                    Tag="翻頁筆" Style="{StaticResource SectionHeaderButton}" />
                            <StackPanel x:Name="PenSectionBody" Margin="0,8,0,12" Visibility="Collapsed">
                                <TextBlock x:Name="BoundDeviceText" Text="尚未綁定" Foreground="{DynamicResource TealBrush}"
                                           FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="BindButton" Content="綁定翻頁筆" Click="BindButton_Click" Style="{StaticResource FlatButton}" Margin="0" />
                                    <Button Grid.Column="2" x:Name="UnbindButton" Content="解除綁定" Click="UnbindButton_Click" Style="{StaticResource FlatButton}" Margin="0" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource LineBrush}" />

                        <!-- 素材 -->
                        <StackPanel x:Name="MaterialPanel" Margin="16,14,16,12" Visibility="Collapsed">
                            <TextBlock Text="選中的素材" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="SelectedMaterialText" Text="—" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="ReexportButton" Content="重新匯出" Click="ReexportMaterial_Click" Style="{StaticResource FlatButton}" Margin="0" />
                                <Button Grid.Column="2" x:Name="RemoveMaterialButton" Content="移除" Click="RemoveMaterial_Click" Style="{StaticResource FlatButton}" Margin="0" />
                            </Grid>
                        </StackPanel>

                        <!-- 網頁／經文的補充操作 -->
                        <StackPanel x:Name="WebNavPanel" Margin="16,14,16,12" Visibility="Collapsed">
                            <TextBlock Text="網頁控制" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="ExtraPushHint" Text="尚未推送投影，按中間「推送投影」才會上螢幕 2。"
                                       Foreground="{DynamicResource AmberBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Button x:Name="WebReloadButton" Content="重新載入" Click="WebReload_Click"
                                    Style="{StaticResource FlatButton}" Margin="0,0,0,8" HorizontalAlignment="Stretch" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="WebBackButton" Content="瀏覽上一頁" Click="WebBack_Click"
                                        Style="{StaticResource FlatButton}" Margin="0" />
                                <Button Grid.Column="2" x:Name="WebForwardButton" Content="瀏覽下一頁" Click="WebForward_Click"
                                        Style="{StaticResource FlatButton}" Margin="0" />
                            </Grid>
                        </StackPanel>

                        <!-- Zoom 控制 -->
                        <StackPanel x:Name="ZoomPanel" Margin="16,14,16,12" Visibility="Collapsed">
                            <TextBlock Text="Zoom 會議投影" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="ZoomStatusText" Text="尚未偵測 Zoom" Foreground="{DynamicResource TextDimBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock x:Name="ZoomWindowText" Text="—" Foreground="{DynamicResource TextFaintBrush}"
                                       FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="開啟 Zoom" Click="ZoomOpen_Click"
                                        Style="{StaticResource FlatButton}" Margin="0" />
                                <Button Grid.Column="2" Content="重新抓取" Click="ZoomRefresh_Click"
                                        Style="{StaticResource FlatButton}" Margin="0" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="鋪到投影幕" Click="ZoomPlace_Click"
                                        Style="{StaticResource PrimaryButton}" Margin="0" />
                                <Button Grid.Column="2" Content="還原視窗" Click="ZoomRestore_Click"
                                        Style="{StaticResource FlatButton}" Margin="0" />
                            </Grid>
                            <TextBlock Text="分享哪個螢幕仍由 Zoom 內部的「分享螢幕」決定；這裡只負責把會議視窗鋪到螢幕 2。"
                                       Foreground="{DynamicResource TextFaintBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>

                        <Border x:Name="MaterialDivider" Height="1" Background="{DynamicResource LineBrush}" />

                        <!-- 控制者 -->
                        <StackPanel Margin="16,14,16,0">
                            <Button x:Name="OwnerSectionHeader" Content="控制者　▾" Click="SectionHeader_Click"
                                    Tag="控制者" Style="{StaticResource SectionHeaderButton}" />
                            <StackPanel x:Name="OwnerSectionBody" Margin="0,8,0,14">
                                <TextBlock x:Name="ControllerText" Text="操作員" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TealBrush}" Margin="0,0,0,8" />
                                <TextBlock x:Name="ControllerHint" Text="由操作員推進。" Foreground="{DynamicResource TextFaintBrush}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Button x:Name="HandoverButton" Content="交給講員" Click="HandoverButton_Click" Style="{StaticResource FlatButton}" Margin="0,0,0,8" />
                                <Button x:Name="ReturnSlideButton" Content="回到交出頁" Click="ReturnSlideButton_Click"
                                        Style="{StaticResource FlatButton}" IsEnabled="False" Margin="0,0,0,8" />
                                <Button x:Name="MobileButton" Content="手機控制…" Click="MobileButton_Click"
                                        Style="{StaticResource FlatButton}" Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ 狀態列 ============ -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PageText" Text="—" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTotalText" Text="/ —" FontSize="14" Foreground="{DynamicResource TextDimBrush}" />
                        <TextBlock Text="頁碼" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" />
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="36" Fill="{DynamicResource LineBrush}" Margin="26,0,26,0" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="控制者" Foreground="{DynamicResource TextFaintBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border x:Name="ControllerChip" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource TealBrush}" BorderThickness="1" CornerRadius="5" Padding="10,4">
                        <TextBlock x:Name="ControllerChipText" Text="操作員" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                    <TextBlock x:Name="SourceStatusText" Text="投影源：—" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center" />
                    <Border x:Name="DebugBadge" Visibility="Collapsed" Margin="14,0,0,0" Padding="9,3"
                            CornerRadius="5" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AmberBrush}" BorderThickness="1">
                        <TextBlock x:Name="DebugBadgeText" Text="調試模式 · 螢幕 2 已模擬"
                                   Foreground="{DynamicResource AmberBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="4" x:Name="LogToggleButton" Content="日誌" Click="LogToggle_Click"
                        Style="{StaticResource FlatButton}" Height="32" Margin="0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ============ 日誌（預設收起） ============ -->
        <Border x:Name="LogPanel" Grid.Row="3" Height="150" Background="{DynamicResource LogBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
            <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Background="{DynamicResource LogBrush}" Foreground="{DynamicResource LogTextBrush}" BorderThickness="0"
                     Padding="16,10" FontFamily="Consolas" FontSize="12" />
        </Border>
    </Grid>
</Window>
